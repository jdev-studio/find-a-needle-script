local JDUI_URL = "https://raw.githubusercontent.com/jdev-studio/jdui/refs/heads/main/JDUI"
local function buildUI()
	local ui = loadstring(game:HttpGet(JDUI_URL))()
	if type(ui) ~= "table" then
		ui = rawget(_G, "JDUI") or getfenv().JDUI
	end
	return ui
end

local VERSION = "1.0.4"
local MENU_KEY, MENU_KEY_NAME = 0xA3, "Right Ctrl"
local SCAN_INTERVAL = 1
local LABEL_INTERVAL = 0.2
local WATCH_FOLDERS = { "HiddenNeedleClient", "NeedleObjectiveServer" }
local COLOR = Color3.fromRGB(255, 60, 60)
local EDGE_MARGIN = 40
local VK_TOGGLE, VK_TRACERS, VK_QUIT = 0x4E, 0x54, 0x23

if not Drawing or type(Drawing.new) ~= "function" then
	print("[NeedleTracker] Drawing library not available in this executor")
	return
end

local Players, player
local clock = os.clock
local V2 = Vector2.new

local function index(inst, prop)
	return inst[prop]
end

local function get(inst, prop)
	local ok, value = pcall(index, inst, prop)
	if ok then
		return value
	end
	return nil
end

local function str(v)
	if v == nil then
		return "?"
	end
	return tostring(v)
end

local function vec2(v)
	local x, y = get(v, "X"), get(v, "Y")
	if type(x) ~= "number" or type(y) ~= "number" then
		return nil
	end
	return x, y
end

local function vec3(v)
	local x, y, z = get(v, "X"), get(v, "Y"), get(v, "Z")
	if type(x) ~= "number" or type(y) ~= "number" or type(z) ~= "number" then
		return nil
	end
	return x, y, z
end

local EMPTY = {}
local function getChildrenOf(inst)
	return inst:GetChildren()
end

local function children(inst)
	if not inst then
		return EMPTY
	end
	local ok, list = pcall(getChildrenOf, inst)
	if ok and type(list) == "table" then
		return list
	end
	return EMPTY
end

local function findChildOf(inst, name)
	return inst:FindFirstChild(name)
end

local function child(inst, name)
	if not inst then
		return nil
	end
	local ok, found = pcall(findChildOf, inst, name)
	if ok then
		return found
	end
	return nil
end

local function getService(name)
	return game:GetService(name)
end

local function service(name)
	local ok, found = pcall(getService, name)
	if ok and found then
		return found
	end
	return child(game, name)
end

local function waitSeconds(t)
	if task and task.wait then
		return task.wait(t)
	end
	return wait(t)
end

do
	local deadline = clock() + 30
	while clock() < deadline do
		Players = Players or service("Players")
		player = Players and get(Players, "LocalPlayer")
		if player then
			break
		end
		waitSeconds(0.25)
	end
	if not player then
		print("[NeedleTracker] couldn't find the local player - rejoin or wait for the game to load, then run again")
		return
	end
end

local RunService = service("RunService")

local function isNeedleName(name)
	return type(name) == "string" and string.find(string.lower(name), "needle", 1, true) ~= nil
end

local function positionOf(inst)
	local x, y, z = vec3(get(inst, "Position"))
	if x then
		return x, y, z
	end
	for _, c in ipairs(children(inst)) do
		x, y, z = vec3(get(c, "Position"))
		if x then
			return x, y, z
		end
	end
	return nil
end

local function scan()
	local result = {}
	local function add(inst, where, holder, backpackOf)
		local name = str(get(inst, "Name"))
		local base = where .. "." .. name
		local key = base
		local n = 1
		while result[key] do
			n = n + 1
			key = base .. " #" .. n
		end
		result[key] = { inst = inst, name = name, holder = holder, backpackOf = backpackOf }
	end

	local watched = {}
	for _, folderName in ipairs(WATCH_FOLDERS) do
		watched[folderName] = true
		local folder = child(workspace, folderName)
		for _, item in ipairs(children(folder)) do
			add(item, folderName)
		end
	end

	for _, item in ipairs(children(workspace)) do
		local name = get(item, "Name")
		if not watched[name] and isNeedleName(name) then
			add(item, "Workspace")
		end
	end

	local cam = get(workspace, "CurrentCamera")
	for _, item in ipairs(children(cam)) do
		if isNeedleName(get(item, "Name")) then
			add(item, "Camera")
		end
	end

	for _, plr in ipairs(children(Players)) do
		local plrName = str(get(plr, "Name"))
		local character = get(plr, "Character")
		for _, item in ipairs(children(character)) do
			if isNeedleName(get(item, "Name")) then
				add(item, plrName, plrName)
			end
		end
		for _, item in ipairs(children(child(plr, "Backpack"))) do
			if isNeedleName(get(item, "Name")) then
				add(item, plrName .. ".Backpack", nil, plrName)
			end
		end
	end
	return result
end

local function newDrawing(kind, props)
	local ok, d = pcall(Drawing.new, kind)
	if not ok or not d then
		return nil
	end
	for k, v in pairs(props) do
		pcall(function()
			d[k] = v
		end)
	end
	return d
end

local function setProp(d, key, value)
	d[key] = value
end

local function set(d, key, value)
	if d then
		pcall(setProp, d, key, value)
	end
end

local function removeDrawing(d)
	if d then
		pcall(function()
			d:Remove()
		end)
	end
end

local function newMarker()
	return {
		tracer = newDrawing("Line", { Color = COLOR, Thickness = 2, Transparency = 1, Visible = false }),
		circle = newDrawing("Circle", { Color = COLOR, Thickness = 2, Radius = 10, NumSides = 24, Filled = false, Transparency = 1, Visible = false }),
		label = newDrawing("Text", { Color = COLOR, Size = 16, Center = true, Outline = true, Transparency = 1, Visible = false }),
		shown = false,
		tracerShown = false,
		text = nil,
	}
end

local function showMarker(m, visible, tracerVisible)
	if m.shown ~= visible then
		set(m.circle, "Visible", visible)
		set(m.label, "Visible", visible)
		m.shown = visible
	end
	local tracer = visible and tracerVisible
	if m.tracerShown ~= tracer then
		set(m.tracer, "Visible", tracer)
		m.tracerShown = tracer
	end
end

local function removeMarker(m)
	removeDrawing(m.tracer)
	removeDrawing(m.circle)
	removeDrawing(m.label)
end

local function screenSize(cam)
	local w, h = vec2(cam and get(cam, "ViewportSize"))
	if w and w > 0 and h > 0 then
		return w, h
	end
	return 1920, 1080
end

local function getComponents(cf)
	return { cf:GetComponents() }
end

local function cameraBasis(cam)
	local cf = cam and get(cam, "CFrame")
	if not cf then
		return nil
	end
	local px, py, pz = vec3(get(cf, "Position"))
	local rx, ry, rz = vec3(get(cf, "RightVector"))
	local ux, uy, uz = vec3(get(cf, "UpVector"))
	local lx, ly, lz = vec3(get(cf, "LookVector"))
	if not (rx and ux and lx) then
		local ok, c = pcall(getComponents, cf)
		if not ok or #c < 12 then
			return nil
		end
		px, py, pz = px or c[1], py or c[2], pz or c[3]
		rx, ry, rz = c[4], c[7], c[10]
		ux, uy, uz = c[5], c[8], c[11]
		lx, ly, lz = -c[6], -c[9], -c[12]
	end
	if not px then
		return nil
	end
	return { px = px, py = py, pz = pz, rx = rx, ry = ry, rz = rz, ux = ux, uy = uy, uz = uz, lx = lx, ly = ly, lz = lz }
end

local function project(fov, b, wx, wy, wz, w, h)
	local dx, dy, dz = wx - b.px, wy - b.py, wz - b.pz
	local x = dx * b.rx + dy * b.ry + dz * b.rz
	local y = dx * b.ux + dy * b.uy + dz * b.uz
	local z = dx * b.lx + dy * b.ly + dz * b.lz
	if z <= 0.05 then
		return nil, nil, false, x, y
	end
	local focal = (h / 2) / math.tan(math.rad(fov) / 2)
	local sx = w / 2 + (x / z) * focal
	local sy = h / 2 - (y / z) * focal
	return sx, sy, sx >= 0 and sx <= w and sy >= 0 and sy <= h, x, y
end

local function edgePoint(dirX, dirY, w, h)
	local dx, dy = dirX, -dirY
	if math.abs(dx) < 1e-6 and math.abs(dy) < 1e-6 then
		dy = 1
	end
	local cx, cy = w / 2, h / 2
	local sx = dx ~= 0 and (cx - EDGE_MARGIN) / math.abs(dx) or math.huge
	local sy = dy ~= 0 and (cy - EDGE_MARGIN) / math.abs(dy) or math.huge
	local s = math.min(sx, sy)
	return cx + dx * s, cy + dy * s
end

local function myPosition()
	local character = get(player, "Character")
	local root = child(character, "HumanoidRootPart") or child(character, "Head")
	return vec3(root and get(root, "Position"))
end

local keyWasDown = {}
local function isKeyDown(vk)
	if type(iskeypressed) ~= "function" then
		return false
	end
	local ok, down = pcall(iskeypressed, vk)
	return ok and down
end

local function pressed(vk)
	local down = isKeyDown(vk)
	local fired = down and not keyWasDown[vk]
	keyWasDown[vk] = down
	return fired
end

local state = {
	enabled = true,
	tracers = true,
	lastEvent = nil,
	lastEventAt = 0,
}
local controls = {}
local tracked = {}
local trackedCount = 0
local nextScan = 0
local nextLabels = 0
local connection
local stopped = false
local ui

local function stop()
	if stopped then
		return
	end
	stopped = true
	if connection then
		pcall(function()
			connection:Disconnect()
		end)
		connection = nil
	end
	for _, info in pairs(tracked) do
		removeMarker(info.marker)
	end
	tracked = {}
	if ui and ui.Alive then
		ui:Destroy()
	end
	print("[NeedleTracker] stopped")
end

do
	local ok, res = pcall(buildUI)
	if ok and type(res) == "table" then
		ui = res
	else
		warn("[NeedleTracker] UI failed to load: " .. tostring(res or "JDUI returned nothing"))
	end
end

if ui then
	local needleTab = ui:AddTab({ Title = "Needle", Icon = "spark" })
	controls.esp = needleTab:AddToggle({
		Title = "Needle ESP",
		Description = "Markers on found needles - Hotkey: N",
		Default = state.enabled,
		Callback = function(v)
			state.enabled = v
		end,
	})
	controls.tracers = needleTab:AddToggle({
		Title = "Tracers",
		Description = "Lines to each needle - Hotkey: T",
		Default = state.tracers,
		Callback = function(v)
			state.tracers = v
		end,
	})
	controls.status = needleTab:AddLabel({ Title = "Waiting for the needle", Description = "It only appears once someone digs it up", Icon = "info" })
	controls.event = needleTab:AddLabel({ Title = "No events yet", Description = "Needles appearing and disappearing show up here", Icon = "bolt" })
	ui.Settings:AddToggle({
		Title = "Menu effects",
		Description = "Glow, dust and border trail",
		Default = ui.Effects,
		Callback = function(v)
			ui.Effects = v
		end,
	})
	for i = #ui.Settings.Controls, 1, -1 do
		if ui.Settings.Controls[i].Title == "Test notification" then
			table.remove(ui.Settings.Controls, i)
		end
	end
	ui.Settings:AddLabel({ Title = "Version " .. VERSION, Description = "Needle Tracker", Icon = "info" })
	ui.Tabs = { needleTab, ui.Settings }
	needleTab:Select()
	pcall(function()
		ui:SetKeybind(MENU_KEY)
	end)
	pcall(function()
		ui:SetConfig("needle_menu")
	end)
	ui.Visible = false

	local origDestroy = ui.Destroy
	ui.Destroy = function(self)
		origDestroy(self)
		stop()
	end
end

local function flip(control, key)
	if control then
		control:SetValue(not control.Value)
	else
		state[key] = not state[key]
	end
end

local function notify(title, content, kind, duration)
	if ui and ui.Alive then
		ui:Notify({ Title = title, Content = content, Type = kind, Duration = duration or 6 })
	end
end

local function updateLabels(entries)
	if not ui then
		return
	end
	if #entries == 0 then
		controls.status.Title = "Waiting for the needle"
		controls.status.Description = "It only appears once someone digs it up"
	else
		controls.status.Title = string.format("Tracking %d object%s", #entries, #entries == 1 and "" or "s")
		controls.status.Description = entries[1].text
	end
	if state.lastEvent then
		controls.event.Title = state.lastEvent
		controls.event.Description = string.format("%ds ago", math.floor(clock() - state.lastEventAt))
	end
end

local function applyResults(found)
	for key, info in pairs(found) do
		local existing = tracked[key]
		if existing then
			existing.inst = info.inst
			existing.holder = info.holder
		else
			local x, y, z = positionOf(info.inst)
			local where = x and string.format(" at (%.1f, %.1f, %.1f)", x, y, z) or ""
			print("[NeedleTracker] NEEDLE APPEARED: " .. key .. where)
			state.lastEvent = "Appeared: " .. info.name
			state.lastEventAt = clock()
			notify("Needle appeared", info.name .. where, "success")
			info.marker = newMarker()
			tracked[key] = info
			trackedCount = trackedCount + 1
		end
	end
	for key, info in pairs(tracked) do
		if not found[key] then
			print("[NeedleTracker] removed: " .. key)
			state.lastEvent = "Removed: " .. info.name
			state.lastEventAt = clock()
			notify("Needle removed", info.name, "info")
			removeMarker(info.marker)
			tracked[key] = nil
			trackedCount = trackedCount - 1
		end
	end
end

local function drawMarkers(entries)
	local cam = state.enabled and get(workspace, "CurrentCamera")
	local basis = cam and cameraBasis(cam)
	local w, h = screenSize(cam)
	local fov = cam and get(cam, "FieldOfView")
	if type(fov) ~= "number" or fov <= 0 then
		fov = 70
	end
	local px, py, pz = myPosition()

	for _, info in pairs(tracked) do
		local m = info.marker
		if info.backpackOf then
			entries[#entries + 1] = { text = info.name .. " in " .. info.backpackOf .. "'s backpack", dist = math.huge }
			showMarker(m, false, false)
		else
			local nx, ny, nz = positionOf(info.inst)
			local text = string.upper(info.name)
			if info.holder then
				text = text .. " (held by " .. info.holder .. ")"
			end
			local dist = math.huge
			if px and nx then
				dist = math.sqrt((nx - px) ^ 2 + (ny - py) ^ 2 + (nz - pz) ^ 2)
				text = text .. " [" .. math.floor(dist + 0.5) .. " studs]"
			end
			entries[#entries + 1] = { text = text, dist = dist }

			local sx, sy, onScreen, dirX, dirY
			if basis and nx then
				sx, sy, onScreen, dirX, dirY = project(fov, basis, nx, ny, nz, w, h)
			end
			if dirX == nil then
				showMarker(m, false, false)
			else
				if not onScreen then
					sx, sy = edgePoint(dirX, dirY, w, h)
				end
				local point = V2(sx, sy)
				if state.tracers then
					set(m.tracer, "From", V2(w / 2, h))
					set(m.tracer, "To", point)
				end
				set(m.circle, "Position", point)
				set(m.label, "Position", V2(sx, sy - 30))
				if m.text ~= text then
					set(m.label, "Text", text)
					m.text = text
				end
				showMarker(m, true, state.tracers)
			end
		end
	end

	table.sort(entries, function(a, b)
		return a.dist < b.dist
	end)
end

local function step()
	if not ui and isKeyDown(VK_QUIT) then
		stop()
		return
	end
	if pressed(VK_TOGGLE) then
		flip(controls.esp, "enabled")
	end
	if pressed(VK_TRACERS) then
		flip(controls.tracers, "tracers")
	end

	local now = clock()
	if now >= nextScan then
		nextScan = now + SCAN_INTERVAL
		applyResults(scan())
	end

	local entries = {}
	if trackedCount > 0 then
		drawMarkers(entries)
	end

	if now >= nextLabels then
		nextLabels = now + LABEL_INTERVAL
		updateLabels(entries)
	end
end

if not RunService then
	print("[NeedleTracker] RunService not found")
	stop()
	return
end

connection = RunService.Heartbeat:Connect(function()
	if stopped then
		return
	end
	local ok, err = pcall(step)
	if not ok then
		warn("[NeedleTracker] stopped after an error: " .. tostring(err))
		stop()
	end
end)

print("[NeedleTracker] v" .. VERSION .. " loaded - " .. (ui and ("press " .. MENU_KEY_NAME .. " to open the menu, ") or "") .. "N = ESP, T = tracers" .. (ui and "" or ", End = stop"))
notify("Needle Tracker v" .. VERSION, "Press " .. MENU_KEY_NAME .. " to open the menu", "success", 10)
